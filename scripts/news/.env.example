# Copy to .env for a local run (`node --env-file=.env run.mjs`). In CI this comes from a repo
# secret instead — never commit a real key, whatever you name this file.
OPENROUTER_API_KEY=sk-or-v1-...

# Optional overrides — defaults live in generate.mjs / run.mjs.
# OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b
# SITE_URL=https://github.com/HrithikL/Landing-Portfolio
# TARGET_PER_CATEGORY=3
